---
import Base from '../layouts/Base.astro';
import Level from '../components/Level.astro';
import sources from '../generated/sources.json';
import stats from '../generated/stats.json';
import { LEVELS, SITE } from '../lib/shared.js';
const role: Record<string, string> = {
  wcvp: '学名、科属、生活型、分布',
  wikidata: '中文名与别名、科属中文名、蘑菇的可食性与形态',
  taicol: '中文名与别名',
  cn_useful: '用途记录与文献、中文名',
  wcfp: '食用、药用等用途，栽培作物，红色名录等级',
  tw_fda: '可供食品使用的部位，未确认安全性的原料',
  tppt: '有毒部位、毒性强弱、毒素',
  cn_toxic_1997: '有毒植物名单',
  commons: '图片',
  inat: '图片',
};
const n = (x: number) => x.toLocaleString('zh-CN');
---
<Base title="关于" current="/about/">
  <div class="wrap">
    <h1 class="page-title">关于百草园</h1>
    <div class="prose">
      <p class="lead">一本开源的中文植物与真菌图鉴，回答三个问题：这是什么、能不能吃、怎么处理。</p>

      <h2>收录</h2>
      <p>{n(stats.plants)} 种植物和 {n(stats.fungi)} 种真菌的名称、分类、分布、用途和毒性记录，来自下面列出的开放数据，更新于 {stats.built}。内容由数据合并而成，尚未经人工审核。</p>

      <h2>安全结论怎么来的</h2>
      <ul>
        <li><strong>取最严。</strong>各来源说法不同时，按最严的一档显示，其余记录一并列出。</li>
        <li><strong>有食用记录不等于可食。</strong>有文献记载食用，只说明有人吃过。钩吻（断肠草）剧毒，也有文献把它记为食用植物。</li>
        <li><strong>可能有毒。</strong>中文名或别名带「毒」「断肠」等字样、又没有毒性记录的，按可能有毒显示。</li>
        <li><strong>未知就是不要吃。</strong>没有证据的物种，一律显示"不要吃"。</li>
        <li><strong>可食要经过审核。</strong>"可食""处理后可食""少量"三档只由人工审核给出。</li>
      </ul>
      <p>番茄因此显示为"有毒"：茎叶含茄碱类毒素，果实另有食用记录。各部位的区别见物种页的部位表。</p>
    </div>

    <section class="section">
      <h2>等级</h2>
      <ul class="legend">
        {Object.entries(LEVELS).map(([k, lv]) => <li><Level level={k} /><span>{lv.hint}</span></li>)}
      </ul>
    </section>

    <section class="section">
      <h2>数据来源</h2>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>来源</th><th>用在哪里</th><th>许可</th><th>版本</th></tr></thead>
          <tbody>
            {sources.filter((s) => role[s.id]).map((s) => (
              <tr>
                <td><a href={s.url} rel="noopener">{s.title}</a>{s.citation && <><br /><span class="muted small">{s.citation}</span></>}</td>
                <td>{role[s.id]}</td>
                <td style="white-space:nowrap">{s.license}</td>
                <td class="small">{s.version}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">只使用开放许可（CC0、CC BY、CC BY-SA、政府开放授权）的数据。各来源的详细说明见 <a href={`${SITE.repo}/blob/main/docs/sources.md`} rel="noopener">docs/sources.md</a>。</p>
    </section>

    <div class="prose">
      <h2>获取数据</h2>
      <ul>
        <li>单个物种：在物种页地址后面加 <code>.json</code>，例如 <a href="/s/Portulaca_oleracea.json">/s/Portulaca_oleracea.json</a>。</li>
        <li>全部数据：仓库里 <a href={`${SITE.repo}/tree/main/data/snapshot`} rel="noopener">data/snapshot</a> 下的 Parquet 表。</li>
        <li>每条记录沿用其来源的许可，使用时请按来源署名。</li>
      </ul>

      <h2>纠错与贡献</h2>
      <p>发现错误，可以从物种页的"纠错"提交。数据、代码和文档都在 <a href={SITE.repo} rel="noopener">GitHub</a> 上。</p>

      <h2>免责</h2>
      <p>野外采食有风险。本站内容不能替代专业鉴定，也不是医疗建议。无法确认的物种一律不要食用；疑似中毒请立即就医，并保留样本。</p>
    </div>
  </div>
</Base>
