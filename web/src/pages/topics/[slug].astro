---
import Base from '../../layouts/Base.astro';
import AidLink from '../../components/AidLink.astro';
import SpeciesList from '../../components/SpeciesList.astro';
import topics from '../../generated/topics.json';
export function getStaticPaths() {
  return topics.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const groups = new Map<string, any[][]>();
for (const it of t.items) {
  const fam = it[4] as string;
  if (!groups.has(fam)) groups.set(fam, []);
  groups.get(fam)!.push(it);
}
---
<Base title={t.title} current="/topics/" description={t.lead}>
  <div class="wrap">
    <nav class="crumbs" aria-label="位置"><a href="/topics/">专题</a></nav>
    <h1 class="page-title">{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <p class="note">{t.source}</p>
    {t.kind === 'danger' && <AidLink />}
    {t.slug === 'poisonous-mushrooms' && <p><a href="/finder/?k=fungus">按特征检索蘑菇</a></p>}
    <p style="margin-top:1rem"><input class="filter" type="search" data-filter placeholder="在本页筛选" aria-label="在本页筛选" /> <span class="muted small" style="margin-left:0.6rem;white-space:nowrap">{t.items.length.toLocaleString('zh-CN')} 种</span></p>
    <div class="topic-groups">
      {[...groups].map(([fam, items]) => (
        <div data-group>
          <h2 class="group-title">{fam}<span class="count">{items.length}</span></h2>
          <SpeciesList items={items} extraIndex={5} flat />
        </div>
      ))}
    </div>
  </div>
</Base>
