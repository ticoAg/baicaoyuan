---
import Base from '../../layouts/Base.astro';
import stats from '../../generated/stats.json';
const tone: Record<string, string> = { danger: 'toxic', warn: 'warn', ok: 'ok', neutral: 'muted' };
---
<Base title="专题" current="/topics/">
  <div class="wrap">
    <h1 class="page-title">专题</h1>
    <p class="lead">按风险和用途整理的清单。</p>
    <section class="section">
      <div class="grid">
        {stats.topics.map((t) => (
          <a class={`card tone-${tone[t.kind]}`} href={`/topics/${t.slug}/`}>
            <h3>{t.title}<span class="count">{t.n.toLocaleString('zh-CN')} 种</span></h3>
            <p>{t.lead}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
