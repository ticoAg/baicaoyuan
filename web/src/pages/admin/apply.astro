---
// 申请成为维护者。
import Base from '../../layouts/Base.astro';
---
<Base title="申请成为维护者" headerSearch={false}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="wrap admin">
    <nav class="crumbs" aria-label="位置"><a href="/admin/">维护</a></nav>
    <h1 class="page-title">申请成为维护者</h1>
    <p class="lead">维护者可以新建词条、改名称和分类、上传照片。通过后，用这里填的名字和密码登录。</p>
    <form class="edit" data-apply>
      <fieldset>
        <label>名字<input name="name" required minlength="2" maxlength="20" autocomplete="username" placeholder="会出现在改动记录里" /></label>
        <label>密码<input name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="至少 8 位" /></label>
        <label class="wide">联系方式<input name="contact" required maxlength="100" placeholder="邮箱、微信或 GitHub，只有管理员看得到" /></label>
        <label class="wide">想维护什么<textarea name="reason" required maxlength="500" rows="4" placeholder="熟悉哪些植物或地区，打算补充什么"></textarea></label>
      </fieldset>
      <div class="edit-actions">
        <button class="btn primary">提交申请</button>
        <p class="form-msg" role="alert"></p>
      </div>
    </form>
    <p class="lead" data-applied hidden>申请已提交。通过后就能<a href="/admin/">登录</a>。</p>
  </div>
  <script>
    import '../../scripts/admin.ts';
  </script>
</Base>
