---
// 维护后台：新建或编辑一个词条的名称、类别和图片。
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { SESSION, whoIs } from '../../lib/admin';
import { SITE } from '../../lib/shared.js';
import { applyPatch, notFound, validId, type Img, type Species } from '../../lib/species';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const who = await whoIs(Astro.cookies.get(SESSION)?.value);
if (!who) return Astro.redirect('/admin/');

const id = Astro.url.searchParams.get('id');
let sp: Partial<Species> = { k: 'plant' };
let dataImage: Img | undefined;
let edited = false;
let created = !id;
if (id) {
  const row = validId(id)
    ? await env.DB.prepare(
        'SELECT (SELECT doc FROM species WHERE id = ?1) AS doc, (SELECT patch FROM edits WHERE id = ?1) AS patch, (SELECT created FROM edits WHERE id = ?1) AS created',
      )
        .bind(id)
        .first<{ doc: string | null; patch: string | null; created: number | null }>()
    : null;
  const base = row?.doc ? (JSON.parse(row.doc) as Species) : null;
  const found = applyPatch(base, row?.patch ?? null);
  if (!found) return notFound(Astro.url);
  sp = found;
  dataImage = base?.img;
  edited = !!row?.patch;
  created = !!row?.created;
}
const title = id ? (sp.zh ?? sp.sci) : '新建词条';
const credit = who.role === 'admin' ? SITE.name : who.name;
---
<Base title={id ? `编辑 ${title}` : '新建词条'} headerSearch={false}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="wrap admin">
    <nav class="crumbs" aria-label="位置"><a href="/admin/">维护</a>{id && <><span aria-hidden="true">›</span><a href={`/s/${id}`}>{title}</a></>}</nav>
    <h1 class="page-title">{id ? title : '新建词条'}</h1>

    <form class="edit" data-edit data-id={id ?? ''}>
      <fieldset>
        <legend>名称</legend>
        <label>学名
          {id ? <output class="sci">{sp.sci}</output> : <input name="sci" class="sci" required placeholder="Toona sinensis" autocomplete="off" spellcheck="false" autofocus />}
        </label>
        <label>中文名<input name="zh" value={sp.zh ?? ''} autocomplete="off" /></label>
        <label class="wide">别名<input name="alias" value={(sp.alias ?? []).join('、')} placeholder="用顿号或逗号分开" autocomplete="off" /></label>
      </fieldset>

      <fieldset>
        <legend>类别</legend>
        <div class="kinds wide">
          <label><input type="radio" name="k" value="plant" checked={sp.k !== 'fungus'} />植物</label>
          <label><input type="radio" name="k" value="fungus" checked={sp.k === 'fungus'} />真菌</label>
        </div>
        <label>科<input name="fam" class="sci" value={sp.fam ?? ''} list="families" placeholder="Meliaceae" autocomplete="off" spellcheck="false" /></label>
        <label>科的中文名<input name="famZh" value={sp.famZh ?? ''} placeholder="楝科" autocomplete="off" /></label>
        <label>属<output class="sci" data-gen>{sp.gen ?? ''}</output></label>
        <label>属的中文名<input name="genZh" value={sp.genZh ?? ''} placeholder="香椿属" autocomplete="off" /></label>
        <datalist id="families"></datalist>
      </fieldset>

      <fieldset>
        <legend>图片</legend>
        <ul class="pics wide" data-pics>
          {(sp.imgs ?? []).map((im) => (
            <li class="pic" data-url={im.url}>
              <img src={im.thumb} alt="" />
              <div><button type="button" data-first>设为首图</button><button type="button" data-drop>去掉</button></div>
            </li>
          ))}
          {dataImage && (
            <li class:list={['pic', { off: !sp.img }]} data-data>
              <img src={dataImage.thumb} alt="" referrerpolicy="no-referrer" />
              <div><button type="button" data-toggle>{sp.img ? '去掉' : '恢复'}</button></div>
            </li>
          )}
          <li class="pic-add"><label><b aria-hidden="true">＋</b>添加照片<input type="file" name="image" accept="image/*" multiple class="visually-hidden" /></label></li>
        </ul>
        <template data-pic>
          <li class="pic">
            <img alt="" />
            <div><button type="button" data-first>设为首图</button><button type="button" data-drop>去掉</button></div>
          </li>
        </template>
        <p class="note wide">只传自己拍的照片，署名{credit}，按 CC BY 4.0 公开。</p>
      </fieldset>

      <div class="edit-actions">
        <button class="btn primary">保存</button>
        {id && edited && who.role === 'admin' && <button type="button" class="btn danger" data-remove>{created ? '删除词条' : '放弃全部改动'}</button>}
        <p class="form-msg" role="alert"></p>
      </div>
    </form>
  </div>
  <script>
    import '../../scripts/admin.ts';
  </script>
</Base>
