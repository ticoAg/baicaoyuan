---
import Base from '../layouts/Base.astro';
import Camera from '../components/Camera.astro';
import SearchBox from '../components/SearchBox.astro';
import Level from '../components/Level.astro';
import stats from '../generated/stats.json';
import { LEVELS } from '../lib/shared.js';
const n = (x: number) => x.toLocaleString('zh-CN');
const tone: Record<string, string> = { danger: 'toxic', warn: 'warn', ok: 'ok', neutral: 'muted' };
const tries = [['马齿苋', '/s/Portulaca_oleracea'], ['钩吻', '/s/Gelsemium_elegans'], ['番茄', '/s/Solanum_lycopersicum'], ['致命鹅膏', '/s/Amanita_exitialis'], ['香椿', '/s/Toona_sinensis']];
const legend = ['edible', 'processed', 'limited', 'toxic', 'deadly', 'suspect', 'restricted', 'food_record', 'unknown'];
---
<Base headerSearch={false}>
  <section class="hero" data-shards={stats.featured}>
    <div class="wrap hero-grid">
      <div>
        <h1><span>这是什么，</span><span><em>能不能吃</em>，</span><span>怎么处理</span></h1>
        <p class="lead">开源的中文植物与真菌图鉴。能不能吃，按部位给出结论，每条都有出处。</p>
        <div class="hero-find">
          <SearchBox autofocus placeholder="搜一种植物或蘑菇：马齿苋 / mcx / Portulaca" />
          <a class="shoot-link" href="/identify/"><Camera /><span>拍照识别</span></a>
        </div>
        <p class="tries">试试　{tries.map(([t, href]) => <a href={href}>{t}</a>)}</p>
      </div>
      <a class="pick big" data-slot="big" aria-hidden="true" tabindex="-1"><span class="pick-img"></span></a>
    </div>
  </section>

  <div class="wrap">
    <section class="section discover">
      <h2>随手翻翻<button type="button" class="again" data-again>换一批</button></h2>
      <div class="picks">
        {Array.from({ length: 8 }, () => <a class="pick" data-slot aria-hidden="true" tabindex="-1"><span class="pick-img"></span><span class="pick-body"><b>&nbsp;</b><i class="sci">&nbsp;</i></span></a>)}
      </div>
    </section>
    <noscript><style>{'.discover, .hero .pick { display: none; }'}</style></noscript>

    <section class="section">
      <h2>专题</h2>
      <div class="grid topics">
        {stats.topics.map((t) => (
          <a class={`card tone-${tone[t.kind]}`} href={`/topics/${t.slug}/`}>
            <h3>{t.title}<span class="count">{n(t.n)} 种</span></h3>
            <p>{t.lead}</p>
          </a>
        ))}
        <a class="card" href="/t/">
          <h3>分类浏览<span class="count">{n(stats.families)} 科 {n(stats.genera)} 属</span></h3>
          <p>按科、属查找。</p>
        </a>
      </div>
    </section>

    <section class="section">
      <h2>安全等级</h2>
      <ul class="legend">
        {legend.map((k) => <li><Level level={k} /><span>{LEVELS[k as keyof typeof LEVELS].hint}</span></li>)}
      </ul>
      <p class="note" style="margin-top:0.9rem">常见食物只看平常吃的部位；其余的，各来源说法不同时按最严的一档显示。有食用记录不等于可食。<a href="/about/">结论怎么来的</a></p>
    </section>

    <section class="section">
      <h2>收录</h2>
      <dl class="stats">
        <div><dt>植物</dt><dd>{n(stats.plants)}</dd></div>
        <div><dt>真菌</dt><dd>{n(stats.fungi)}</dd></div>
        <div><dt>中文名与别名</dt><dd>{n(stats.names)}</dd></div>
        <div><dt>有照片</dt><dd>{n(stats.images)}</dd></div>
        <div><dt>用途记录</dt><dd>{n(stats.uses)}</dd></div>
        <div><dt>有毒或致命</dt><dd>{n(stats.bySafety.toxic + stats.bySafety.deadly)}</dd></div>
        <div><dt>可能有毒</dt><dd>{n(stats.bySafety.suspect)}</dd></div>
        <div><dt>有食用记录</dt><dd>{n(stats.bySafety.food_record)}</dd></div>
      </dl>
    </section>
  </div>
</Base>

<script>
  import '../scripts/discover.ts';
</script>
