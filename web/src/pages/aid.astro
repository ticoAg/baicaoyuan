---
// 急救页：一屏看完，能直接拨号。预渲染，随应用外壳缓存，没有网络也能打开。
// 地区按时区猜，选过的记在本机。没有把握的地区不给号码，只说打当地急救电话。
import Base from '../layouts/Base.astro';

// [代码, 名称, 急救电话, [第二个号码的说明, 号码]?]
const regions: [string, string, string?, [string, string]?][] = [
  ['cn', '中国大陆', '120'],
  ['hk', '香港', '999'],
  ['mo', '澳门', '999'],
  ['tw', '台湾', '119'],
  ['sg', '新加坡', '995'],
  ['my', '马来西亚', '999'],
  ['th', '泰国', '1669'],
  ['jp', '日本', '119'],
  ['kr', '韩国', '119'],
  ['us', '美国', '911', ['中毒咨询', '1-800-222-1222']],
  ['ca', '加拿大', '911'],
  ['gb', '英国', '999', ['不确定时问 NHS', '111']],
  ['eu', '欧洲', '112'],
  ['au', '澳大利亚', '000', ['中毒咨询', '13 11 26']],
  ['nz', '新西兰', '111', ['中毒咨询', '0800 764 766']],
  ['other', '其他地区'],
];
// 时区 → 地区。时区名有旧写法（PRC、Hongkong 等），一并列上。
const zones: [string, string][] = [
  ['cn', '^(Asia/(Shanghai|Chongqing|Chungking|Harbin|Urumqi|Kashgar)|PRC)$'],
  ['hk', '^(Asia/Hong_Kong|Hongkong)$'],
  ['mo', '^Asia/Maca[ou]$'],
  ['tw', '^(Asia/Taipei|ROC)$'],
  ['sg', '^(Asia/Singapore|Singapore)$'],
  ['my', '^Asia/(Kuala_Lumpur|Kuching)$'],
  ['th', '^Asia/Bangkok$'],
  ['jp', '^(Asia/Tokyo|Japan)$'],
  ['kr', '^(Asia/Seoul|ROK)$'],
  ['ca', '^(America/(Toronto|Montreal|Nipigon|Thunder_Bay|Rainy_River|Atikokan|Vancouver|Edmonton|Calgary|Winnipeg|Regina|Swift_Current|Halifax|Glace_Bay|Moncton|Goose_Bay|St_Johns|Blanc-Sablon|Whitehorse|Dawson|Dawson_Creek|Creston|Fort_Nelson|Yellowknife|Inuvik|Cambridge_Bay|Rankin_Inlet|Resolute|Iqaluit|Pangnirtung)|Canada/.+)$'],
  ['us', '^(America/(New_York|Chicago|Denver|Los_Angeles|Phoenix|Anchorage|Juneau|Sitka|Metlakatla|Yakutat|Nome|Adak|Boise|Detroit|Menominee|Louisville|Indianapolis|Fort_Wayne|Indiana/.+|Kentucky/.+|North_Dakota/.+)|Pacific/Honolulu|US/.+)$'],
  ['gb', '^(Europe/(London|Belfast|Jersey|Guernsey|Isle_of_Man)|GB|GB-Eire)$'],
  ['eu', '^Europe/'],
  ['au', '^Australia/'],
  ['nz', '^(Pacific/(Auckland|Chatham)|NZ|NZ-CHAT)$'],
];
const tel = (n: string) => `tel:${n.replace(/[^0-9+]/g, '')}`;
const [, , num0] = regions[0];
---
<Base title="急救" description="疑似吃了有毒的蘑菇或植物：现在就打急救电话，没有症状也要去医院。" current="/aid/">
  <div class="wrap aid-page">
    <h1 class="page-title">疑似中毒</h1>

    <section class="aid-call" aria-label="急救电话" data-aid>
      <a class="aid-btn" href={tel(num0!)} data-call>
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path d="M6.6 3.5h2.6l1.4 4.3-2 1.6a12 12 0 005.9 5.9l1.6-2 4.3 1.4v2.6a2 2 0 01-2.2 2A16.5 16.5 0 014.6 5.7a2 2 0 012-2.2z" fill="currentColor"/></svg>
        <span>拨打 <b data-num>{num0}</b></span>
      </a>
      <p class="aid-local" data-local hidden>拨打当地的急救电话</p>
      <a class="aid-btn2" href="#" data-second hidden><span data-second-label></span> <b data-second-num></b></a>
      <label class="aid-region">地区
        <select data-region>
          {regions.map(([code, name]) => <option value={code}>{name}</option>)}
        </select>
      </label>
      <noscript>
        <ul class="aid-all">
          {regions.filter((r) => r[2]).map(([, name, num, second]) => (
            <li>{name} <a href={tel(num!)}>{num}</a>{second && <> · {second[0]} <a href={tel(second[1])}>{second[1]}</a></>}</li>
          ))}
        </ul>
      </noscript>
    </section>

    <ol class="aid-steps">
      <li><p><b>现在就打电话或去医院，没有症状也要去。</b>让别人送，不要自己开车。</p></li>
      <li><p><b>带上吃剩的蘑菇或植物</b>，没有剩的就拍照，给医生辨认。</p></li>
      <li><p><b>一起吃过的人，一起去。</b></p></li>
      <li><p><b>记下时间和分量：</b>几点吃的，吃了多少，几点开始不舒服。</p></li>
      <li><p><b>不要再吃喝东西，不要自己催吐。</b>大蒜、银器、久煮、泡酒都不能验毒，也不能解毒。</p></li>
      <li><p><b>吐泻好了也不等于没事。</b>有的毒蘑菇 6 小时以后才发作；症状缓解时，毒素可能还在损伤肝和肾。</p></li>
    </ol>

    <p class="note aid-offline">加到主屏幕后，没有网络也能打开这一页。</p>

    <details class="refs aid-refs">
      <summary>依据</summary>
      <ol>
        <li><a href="https://www.health.nsw.gov.au/environment/factsheets/Pages/wild-mushroom-poisoning-simplified-chinese.aspx" rel="noopener">野生蘑菇中毒</a> · 新南威尔士州卫生厅，2026 年 3 月</li>
        <li><a href="https://www.nhs.uk/conditions/poisoning/" rel="noopener">Poisoning</a> · NHS，2025 年 6 月</li>
        <li><a href="https://www.msdmanuals.com/home/injuries-and-poisoning/poisoning/mushroom-toadstool-poisoning" rel="noopener">Mushroom (Toadstool) Poisoning</a> · 默沙东诊疗手册大众版</li>
        <li><a href="https://www.news.cn/20260919/cfab5ce419564c02ae62ec71384e19dc/c.html" rel="noopener">别乱采野生蘑菇 专家提醒警惕中毒"假愈期"</a> · 新华社，2026 年 9 月</li>
        <li><a href="https://poisonhelp.hrsa.gov/" rel="noopener">Poison Help</a>（美国）· <a href="https://poisons.co.nz/" rel="noopener">National Poisons Centre</a>（新西兰）</li>
      </ol>
    </details>
  </div>

  <script is:inline define:vars={{ regions, zones }}>
    (() => {
      const root = document.querySelector('[data-aid]');
      const select = root.querySelector('[data-region]');
      const call = root.querySelector('[data-call]');
      const second = root.querySelector('[data-second]');
      const local = root.querySelector('[data-local]');
      const tel = (n) => 'tel:' + n.replace(/[^0-9+]/g, '');
      const guess = () => {
        let zone = '';
        try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch {}
        const hit = zones.find(([, re]) => new RegExp(re).test(zone));
        return hit ? hit[0] : 'other';
      };
      const show = (code) => {
        const [, , num, extra] = regions.find((r) => r[0] === code) ?? regions[regions.length - 1];
        call.hidden = !num;
        local.hidden = !!num;
        if (num) {
          call.href = tel(num);
          call.querySelector('[data-num]').textContent = num;
        }
        second.hidden = !extra;
        if (extra) {
          second.href = tel(extra[1]);
          second.querySelector('[data-second-label]').textContent = extra[0];
          second.querySelector('[data-second-num]').textContent = extra[1];
        }
      };
      let saved = null;
      try { saved = localStorage.getItem('bcy-region'); } catch {}
      select.value = regions.some((r) => r[0] === saved) ? saved : guess();
      show(select.value);
      select.addEventListener('change', () => {
        try { localStorage.setItem('bcy-region', select.value); } catch {}
        show(select.value);
      });
    })();
  </script>
</Base>
