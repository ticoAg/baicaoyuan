---
import '../styles/global.css';
import Camera from '../components/Camera.astro';
import SearchBox from '../components/SearchBox.astro';
import { SITE } from '../lib/shared.js';
interface Props { title?: string; description?: string; headerSearch?: boolean; current?: string }
const { title, description = '开源的中文植物与真菌图鉴：这是什么、能不能吃、怎么处理。每条结论带出处。', headerSearch = true, current } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const path = Astro.url.pathname;
const here = (href: string) => current === href || (href === '/' ? path === '/' : path.startsWith(href));
const nav = [
  ['/identify/', '识别'],
  ['/finder/', '检索'],
  ['/topics/', '专题'],
  ['/t/', '分类'],
  ['/about/', '关于'],
];
// 手机底栏的图标：24×24，描边
const icon = {
  home: '<path d="M3.5 10.5 12 3.8l8.5 6.7V20a.5.5 0 0 1-.5.5h-5.2v-6h-5.6v6H4a.5.5 0 0 1-.5-.5z"/>',
  finder: '<path d="M3.5 5h17l-6.6 7.8v5.6l-3.8 2.1v-7.7z"/>',
  topics: '<rect x="3.5" y="3.5" width="7" height="7" rx="1"/><rect x="13.5" y="3.5" width="7" height="7" rx="1"/><rect x="3.5" y="13.5" width="7" height="7" rx="1"/><rect x="13.5" y="13.5" width="7" height="7" rx="1"/>',
  aid: '<path d="M9 3.5h6v5.5h5.5v6H15v5.5H9V15H3.5V9H9z"/>',
};
const tabs = [
  ['/', '首页', icon.home],
  ['/identify/', '识别', null],
  ['/finder/', '检索', icon.finder],
  ['/topics/', '专题', icon.topics],
  ['/aid/', '急救', icon.aid],
] as const;
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2c6a4c" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">百草<span>园</span></a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map(([href, label]) => <a href={href} aria-current={here(href) ? 'page' : undefined}>{label}</a>)}
          <a class="aid" href="/aid/" aria-current={here('/aid/') ? 'page' : undefined}>急救</a>
        </nav>
        {headerSearch && <SearchBox />}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p><strong>野外采食有风险。</strong>本站内容不能替代专业鉴定；无法确认的物种一律不要食用。疑似中毒请立即就医，并保留样本：<a href="/aid/">急救</a>。</p>
          <p>数据来自开放许可的来源，每条记录注明出处。除了常见食物，安全结论尚未经人工审核。</p>
        </div>
        <nav aria-label="页脚">
          <a href="/t/">分类</a>
          <a href="/about/">数据来源与许可</a>
          <a href="/admin/">参与维护</a>
          <a href={SITE.repo} rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>
    <nav class="tabbar" aria-label="主导航">
      {tabs.map(([href, label, svg]) => (
        <a href={href} class={href === '/aid/' ? 'aid' : undefined} aria-current={here(href) ? 'page' : undefined}>
          {svg ? <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" set:html={svg} /> : <Camera size={24} />}
          <span>{label}</span>
        </a>
      ))}
    </nav>
    <script>
      import '../scripts/search.ts';
    </script>
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      </script>
    )}
  </body>
</html>
