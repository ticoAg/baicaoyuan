---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';
import { SITE } from '../lib/shared.js';
interface Props { title?: string; description?: string; headerSearch?: boolean; current?: string }
const { title, description = '开源的中文植物与真菌图鉴：这是什么、能不能吃、怎么处理。每条结论带出处。', headerSearch = true, current } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const nav = [
  ['/topics/', '专题'],
  ['/t/', '分类'],
  ['/about/', '关于'],
];
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#2c6a4c" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">百草<span>园</span></a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map(([href, label]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        {headerSearch && <SearchBox />}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p><strong>野外采食有风险。</strong>本站内容不能替代专业鉴定；无法确认的物种一律不要食用。疑似中毒请立即就医，并保留样本。</p>
          <p>数据来自开放许可的来源，每条记录注明出处。安全结论尚未经人工审核。</p>
        </div>
        <nav aria-label="页脚">
          <a href="/about/">数据来源与许可</a>
          <a href={SITE.repo} rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/search.ts';
    </script>
  </body>
</html>
