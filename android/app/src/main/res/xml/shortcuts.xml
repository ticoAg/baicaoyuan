<?xml version="1.0" encoding="utf-8"?>
<!-- 长按图标出现的入口，和 web/public/manifest.webmanifest 的 shortcuts 一致 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="25">
    <shortcut
        android:icon="@drawable/ic_shortcut_aid"
        android:shortcutId="aid"
        android:shortcutShortLabel="@string/shortcut_aid">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://plants.ticoag.fun/aid/"
            android:targetClass="io.github.ticoag.baicaoyuan.MainActivity"
            android:targetPackage="io.github.ticoag.baicaoyuan" />
    </shortcut>
    <shortcut
        android:icon="@drawable/ic_shortcut_finder"
        android:shortcutId="finder"
        android:shortcutLongLabel="@string/shortcut_finder_long"
        android:shortcutShortLabel="@string/shortcut_finder">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://plants.ticoag.fun/finder/"
            android:targetClass="io.github.ticoag.baicaoyuan.MainActivity"
            android:targetPackage="io.github.ticoag.baicaoyuan" />
    </shortcut>
    <shortcut
        android:icon="@drawable/ic_shortcut_identify"
        android:shortcutId="identify"
        android:shortcutLongLabel="@string/shortcut_identify_long"
        android:shortcutShortLabel="@string/shortcut_identify">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://plants.ticoag.fun/identify/"
            android:targetClass="io.github.ticoag.baicaoyuan.MainActivity"
            android:targetPackage="io.github.ticoag.baicaoyuan" />
    </shortcut>
</shortcuts>
